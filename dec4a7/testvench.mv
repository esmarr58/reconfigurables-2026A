`timescale 1ns/1ps

module tb_bcd_7seg;

reg x;
reg w;
reg y;
reg z;

wire a;
wire b;
wire c;
wire d;
wire e;
wire f;
wire g;

// Instancia del DUT (Device Under Test)
bcd_7seg_anodo_comun dut (
    .x(x),
    .w(w),
    .y(y),
    .z(z),
    .a(a),
    .b(b),
    .c(c),
    .d(d),
    .e(e),
    .f(f),
    .g(g)
);

integer i;

initial begin

    // Inicialización
    x = 0;
    w = 0;
    y = 0;
    z = 0;

    // Recorrer todas las combinaciones de entrada
    for (i = 0; i < 16; i = i + 1) begin
        {x,w,y,z} = i;
        #10;
    end

    // Finalizar simulación
    #10;
    $stop;

end

endmodule
